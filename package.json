{
  "name": "successor",
  "version": "0.0.1",
  "private": true,
  "description": "Successor 3D and terminal MMORPG runtime",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:authority-bridge": "CARGO_PROFILE_DEV_OPT_LEVEL=2 cargo build --locked -q -p successor-sim --example authority_bridge_server",
    "dev": "pnpm -r --parallel dev",
    "desktop:dev": "pnpm --dir desktop dev",
    "desktop:build": "pnpm --dir client-3d build && pnpm --dir desktop build",
    "release:package:desktop": "SUCCESSOR_PACKAGE_MODE=hosted-release pnpm --dir client-3d build && SUCCESSOR_PACKAGE_MODE=hosted-release pnpm --dir desktop build",
    "release:package:desktop:offline": "SUCCESSOR_PACKAGE_MODE=offline-full pnpm --dir client-3d build && SUCCESSOR_PACKAGE_MODE=offline-full pnpm --dir desktop build",
    "desktop:smoke": "node tools/verification/desktop-smoke.mjs",
    "site:build": "pnpm --dir site build",
    "site:test": "pnpm --dir site test && pnpm --dir site check:budget",
    "server:local:persistent": "node scripts/server-local-persistent.mjs",
    "client-rust:build": "make -C client-rust all",
    "client-rust:verify": "make -C client-rust verify",
    "bugreports": "pnpm --dir server bugreports",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:rust": "cargo test --workspace",
    "test:invite-alpha": "pnpm --dir server test:durability && pnpm --dir client-3d test && pnpm deploy:contract",
    "release:seal": "node tools/release/seal.mjs",
    "release:promote:staging": "node tools/release/promote-staging.mjs",
    "release:package:tui": "node tools/release/package-tui.mjs",
    "test:release:tui": "node --test tools/release/package-tui.test.mjs",
    "deploy:contract": "bash ops/deploy/validate.sh",
    "hygiene": "bash tools/hygiene/run.sh",
    "hygiene:rust": "bash tools/hygiene/run.sh --rust",
    "hygiene:ts": "bash tools/hygiene/run.sh --ts",
    "codegen:commands": "cargo run -p successor-sim --bin emit_command_manifest -- tools/codegen/generated/successor.commands.manifest.v1.json && node tools/codegen/commands.mjs",
    "check:commands": "node tools/codegen/commands.mjs --check",
    "check:coverage": "node tools/verification/coverage/check.mjs",
    "codegen:wardrobe": "node tools/codegen/wardrobe.mjs",
    "check:wardrobe": "node tools/codegen/wardrobe.mjs --check",
    "check:zero-gpu": "node tools/verification/play-gate.mjs --zero-gpu-check-only --skip-build",
    "build:verify": "node tools/verification/verify-full.mjs --build-only",
    "verify:fast": "node tools/verification/select.mjs",
    "verify:compress-bridge": "node tools/verification/verify-compress-bridge.mjs",
    "verify:full": "node tools/verification/verify-full.mjs",
    "verify:standalone": "node tools/verification/standalone/run.mjs",
    "verify:public-browser": "node tools/verification/public-browser-proof.mjs",
    "verify:public-native": "node tools/verification/public-native-proof.mjs",
    "play:gate": "node tools/verification/play-gate.mjs",
    "play:flow": "node tools/successor/play-flows/cli.mjs",
    "tui:gate": "node client-tui/journeys/runner.mjs",
    "3d:gate": "node tools/verification/client3d/run-journeys.mjs",
    "lifecycle:gate": "GAME_ALLOW_DEV_IDENTITY=1 node tools/verification/play-gate.mjs --only cohesive-long-haul-restart,multiplayer-bank-clone-corpse-restart,concurrent-three-player-trade,core-world-restart-persistence,active-systems-restart-persistence,resource-land-restart-persistence,profession-travel-restart-persistence --concurrency 3",
    "lifecycle:3d": "GAME_ALLOW_DEV_IDENTITY=1 node tools/verification/client3d/run-journeys.mjs --only=bank-clone-corpse --only=trade --only=loot --only=revive --only=travel --concurrency=1",
    "gate:all": "GAME_ALLOW_DEV_IDENTITY=1 pnpm play:gate && GAME_ALLOW_DEV_IDENTITY=1 pnpm tui:gate && GAME_ALLOW_DEV_IDENTITY=1 pnpm 3d:gate",
    "sim:players": "node tools/verification/simplayer/population-runner.mjs",
    "load:players": "node tools/verification/load/player-load.mjs",
    "load:players:smoke": "node tools/verification/load/player-load.mjs --clients 5 --stages 5",
    "load:players:cross-host": "node tools/verification/load/cross-host.mjs",
    "bench:aoi-1000": "node tools/verification/aoi-shard-bench.mjs",
    "bench:game-ws": "pnpm --dir server bench:game:ws",
    "optimize:netcode": "node tools/verification/netcode-optimization-suite.mjs",
    "verify:successor-context": "node tools/verification/successor-context-gate.mjs && node tools/verification/private-path-gate.mjs",
    "test:fixture-contract": "node --test tools/successor/compile-map-bundle.test.mjs tools/successor/structure-collision-geometry.test.mjs",
    "verify:private-paths": "node tools/verification/private-path-gate.mjs",
    "replay:authority": "node tools/verification/sim-authority-replay.mjs",
    "farm:plan": "node tools/verification/farm/dispatch.mjs plan --lanes rust,node,accel,realtime,tui,3d,desktop",
    "farm:dispatch": "node tools/verification/farm/dispatch.mjs dispatch",
    "farm:worker": "node tools/verification/farm/worker.mjs",
    "farm:preflight": "node tools/verification/farm/preflight.mjs",
    "test:farm": "node --test tools/verification/farm/*.test.mjs",
    "test:verification": "node --test tools/verification/farm/*.test.mjs tools/verification/load/*.test.mjs",
    "farm:mac:plan": "node tools/verification/farm/dispatch.mjs plan --remote-host macbook",
    "denylist": "bash tools/denylist/check.sh",
    "security:audit": "pnpm audit --prod --audit-level high",
    "ci": "pnpm verify:successor-context && pnpm check:commands && pnpm check:coverage && pnpm test:verification && pnpm deploy:contract && bash tools/denylist/check.sh && pnpm security:audit && pnpm build:authority-bridge && pnpm -r build && pnpm -r test"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.33.0"
  }
}
