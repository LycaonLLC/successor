{
  "name": "@successor/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./headless": {
      "types": "./src/headless/index.ts",
      "import": "./dist/headless/index.js"
    },
    "./src/*": "./src/*.ts"
  },
  "bin": {
    "successor-play": "./dist/headless/cli.js"
  },
  "scripts": {
    "build": "tsc && vite build --config vite.headless.config.ts",
    "build:headless": "vite build --config vite.headless.config.ts",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "verify:slice-specs": "node scripts/verify-slice-specs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.0.1",
    "eslint": "10.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.42"
  }
}
