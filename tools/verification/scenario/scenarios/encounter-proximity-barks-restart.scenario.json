{
  "schema": "successor.scenario.v1",
  "name": "encounter-proximity-barks-restart",
  "fixture": "open-desert-procedural-encounter",
  "persistence": true,
  "lanes": ["accel", "realtime"],
  "matrixLanes": ["accel"],
  "realtimeReason": "Procedural encounter AI, actor-routed bark fanout, and restart-frozen encounter state require a live clock lane.",
  "tags": ["encounter", "npc", "bark", "loot", "restart"],
  "actors": {
    "alpha": { "character": "fixture:alpha" },
    "beta": { "character": "fixture:beta" }
  },
  "steps": [
    { "await": { "kind": "query", "actor": "alpha", "query": "/nearby hostile", "match": { "data.actors": { "includesObject": { "id": "open-desert-rogue-001-01", "lifeState": "alive" } } }, "timeoutMs": 20000, "as": "initialSkirmishers" } },
    { "expect": { "kind": "captureCompare", "capture": "initialSkirmishers", "path": "data.actors", "op": "length", "value": 2 } },
    { "expect": { "kind": "captureCompare", "capture": "initialSkirmishers", "path": "data.actors[0].id", "op": "eq", "value": "open-desert-rogue-001-01" } },
    { "expect": { "kind": "captureCompare", "capture": "initialSkirmishers", "path": "data.actors[1].id", "op": "eq", "value": "open-desert-rogue-001-02" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "role": "skirmisher", "lifeState": "alive", "x": { "op": "gte", "value": 172 }, "y": { "op": "gte", "value": 162 } } }, "timeoutMs": 15000, "as": "skirmisherOneInitial" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-02", "match": { "role": "skirmisher", "lifeState": "alive", "x": { "op": "gte", "value": 172 }, "y": { "op": "gte", "value": 162 } } }, "timeoutMs": 15000, "as": "skirmisherTwoInitial" } },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 168, "y": 162, "toleranceCells": 0.5, "sprint": false, "maxPulses": 120 } }, "timeoutMs": 30000, "as": "alphaApproach" },
    { "await": { "kind": "event", "actor": "beta", "event": "dialogue", "match": { "data.delivery.actorId": "open-desert-rogue-001-01", "data.delivery.speaker": { "exists": true }, "data.delivery.body": { "regex": ".+" }, "data.delivery.areaId": "open-desert-overworld" }, "timeoutMs": 40000, "as": "betaBark" } },
    { "await": { "kind": "event", "actor": "alpha", "event": "dialogue", "match": { "data.delivery.actorId": "$captures.betaBark.data.delivery.actorId", "data.delivery.body": "$captures.betaBark.data.delivery.body", "data.delivery.tick": "$captures.betaBark.data.delivery.tick" }, "timeoutMs": 15000, "as": "alphaBark" } },
    { "expect": { "kind": "envelopeCount", "actor": "alpha", "envelopeType": "event", "match": { "event": "dialogue", "data.delivery.actorId": "$captures.betaBark.data.delivery.actorId", "data.delivery.body": "$captures.betaBark.data.delivery.body", "data.delivery.tick": "$captures.betaBark.data.delivery.tick" }, "op": "eq", "value": 1 } },
    { "expect": { "kind": "envelopeCount", "actor": "beta", "envelopeType": "event", "match": { "event": "dialogue", "data.delivery.actorId": "$captures.betaBark.data.delivery.actorId", "data.delivery.body": "$captures.betaBark.data.delivery.body", "data.delivery.tick": "$captures.betaBark.data.delivery.tick" }, "op": "eq", "value": 1 } },
    { "restart": { "as": "encounterRestart", "timeoutMs": 30000 } },
    { "expect": { "kind": "envelopeCount", "actor": "alpha", "envelopeType": "event", "match": { "event": "dialogue", "data.delivery.actorId": "$captures.betaBark.data.delivery.actorId", "data.delivery.body": "$captures.betaBark.data.delivery.body", "data.delivery.tick": "$captures.betaBark.data.delivery.tick" }, "op": "eq", "value": 1 } },
    { "expect": { "kind": "envelopeCount", "actor": "beta", "envelopeType": "event", "match": { "event": "dialogue", "data.delivery.actorId": "$captures.betaBark.data.delivery.actorId", "data.delivery.body": "$captures.betaBark.data.delivery.body", "data.delivery.tick": "$captures.betaBark.data.delivery.tick" }, "op": "eq", "value": 1 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "lifeState": "alive", "x": { "op": "gte", "value": 160 } } }, "timeoutMs": 15000, "as": "boundedPatrol" } },
    { "expect": { "kind": "captureCompare", "capture": "boundedPatrol", "path": "x", "op": "lt", "value": 185 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "lifeState": "alive", "vitals.health": { "op": "gt", "value": 0 } } }, "timeoutMs": 15000, "as": "rogueOneBeforeStorm" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-02", "match": { "lifeState": "alive", "vitals.health": { "op": "gt", "value": 0 } } }, "timeoutMs": 15000, "as": "rogueTwoBeforeStorm" } },
    { "timeoutMs": 65000, "await": { "kind": "oracle", "condition": { "weather": { "includesObject": { "eventType": "sandstorm", "phase": "active" } } }, "timeoutMs": 60000, "as": "activeStorm" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "lifeState": "alive", "vitals.health": "$captures.rogueOneBeforeStorm.vitals.health" } }, "timeoutMs": 15000, "as": "stormImmuneRogueOne" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-02", "match": { "lifeState": "alive", "vitals.health": "$captures.rogueTwoBeforeStorm.vitals.health" } }, "timeoutMs": 15000, "as": "stormImmuneRogueTwo" } },
    { "action": { "name": "moveTo", "actor": "beta", "args": { "x": 167.5, "y": 161, "toleranceCells": 0.4, "sprint": false, "maxPulses": 180 } }, "timeoutMs": 30000, "as": "betaStageApproach" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "encounter-alpha", "match": { "lifeState": "alive", "vitals.health": { "op": "gt", "value": 0 } } }, "timeoutMs": 15000, "as": "playerBeforeAttack" } },
    { "send": { "actor": "alpha", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "alphaEquip" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaEquip.data.commandId", "commandKind": "SetEquippedWeapon", "accepted": true }, "timeoutMs": 12000 } },
    { "send": { "actor": "alpha", "line": "/target open-desert-rogue-001-01", "as": "alphaTarget" } },
    { "send": { "actor": "alpha", "line": "/attack", "as": "alphaProvocation" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaProvocation.data.commandId", "commandKind": "QueueCombatAction", "accepted": true }, "timeoutMs": 12000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "lifeState": "alive", "vitals.health": { "op": "lt", "value": "$captures.rogueOneBeforeStorm.vitals.health" } } }, "timeoutMs": 40000, "as": "rogueProvoked" } },
    { "timeoutMs": 65000, "action": { "name": "attackUntilDowned", "actor": "alpha", "args": { "targetId": "open-desert-rogue-001-01", "maxTicks": 1800, "pollTicks": 15, "approachRangeCells": 2.0 } }, "as": "firstIncap" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "lifeState": "downed" } }, "timeoutMs": 30000, "as": "firstDead" } },
    { "send": { "actor": "beta", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "betaEquip" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.betaEquip.data.commandId", "commandKind": "SetEquippedWeapon", "accepted": true }, "timeoutMs": 12000 } },
    { "send": { "actor": "beta", "line": "/target open-desert-rogue-001-02", "as": "betaTarget" } },
    { "timeoutMs": 65000, "action": { "name": "attackUntilDowned", "actor": "beta", "args": { "targetId": "open-desert-rogue-001-02", "maxTicks": 1800, "pollTicks": 15, "approachRangeCells": 6.0 } }, "as": "secondIncap" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-02", "match": { "lifeState": "downed" } }, "timeoutMs": 30000, "as": "secondDead" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "lifeState": "downed" } }, "timeoutMs": 15000, "as": "rogueCorpse" } },
    { "restart": { "as": "clearRestart", "timeoutMs": 30000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-01", "match": { "lifeState": "downed" } }, "timeoutMs": 15000, "as": "clearedOne" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-rogue-001-02", "match": { "lifeState": "downed" } }, "timeoutMs": 15000, "as": "clearedTwo" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "footlocker:open-desert-rogue-zone-001-footlocker", "itemId": 1002, "variantId": 0, "minAvailable": 3 }, "timeoutMs": 15000, "as": "footlockerFirstRow" } },
    { "expect": { "kind": "captureCompare", "capture": "footlockerFirstRow", "path": "available", "op": "eq", "value": 3 } },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 167, "y": 164, "toleranceCells": 0.5, "sprint": false, "maxPulses": 180 } }, "timeoutMs": 30000, "as": "alphaRouteLootWest" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 167, "y": 157, "toleranceCells": 0.5, "sprint": false, "maxPulses": 180 } }, "timeoutMs": 30000, "as": "alphaRouteLootNorth" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 172.3, "y": 157, "toleranceCells": 0.15, "pulseMs": 120, "sprint": false, "maxPulses": 180 } }, "timeoutMs": 30000, "as": "alphaRouteLootEast" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 172.3, "y": 159.2, "toleranceCells": 0.2, "pulseMs": 120, "sprint": false, "maxPulses": 180 } }, "timeoutMs": 30000, "as": "alphaRouteLootStand" },
    { "send": { "actor": "alpha", "line": "/loot footlocker:open-desert-rogue-zone-001-footlocker 1002 0 3", "as": "takeFootlocker" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.takeFootlocker.data.commandId", "commandKind": "TakeLootItem", "accepted": true }, "timeoutMs": 12000 } },
    { "restart": { "as": "postTakeRestart", "timeoutMs": 30000 } },
    { "send": { "actor": "alpha", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "postTakeEquip" } },
    { "send": { "actor": "alpha", "line": "/loot footlocker:open-desert-rogue-zone-001-footlocker $captures.footlockerFirstRow.itemId $captures.footlockerFirstRow.variantId 1", "as": "duplicateTake" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.duplicateTake.data.commandId", "commandKind": "TakeLootItem", "accepted": false, "reasonCode": "loot_not_lootable" }, "timeoutMs": 12000 } },
    { "send": { "actor": "alpha", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "postDuplicateEquip" } }
  ],
  "notes": "Uses the generated rogue-zone and take-only footlocker rows. Oracle inventory proves the one authored stack before taking; the authority receipt plus durable duplicate rejection proves full-quantity take and restart persistence. The scenario observes actor-routed dialogue deliveries on both clients, bounded movement, storm immunity, retaliation/death lifecycle, and clear-on-restart encounter state."
}
