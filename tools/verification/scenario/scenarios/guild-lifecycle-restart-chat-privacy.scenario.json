{
  "schema": "successor.scenario.v1",
  "name": "guild-lifecycle-restart-chat-privacy",
  "fixture": "open-desert-guild-lifecycle",
  "persistence": true,
  "lanes": ["accel"],
  "tags": ["guild", "multiplayer", "restart", "chat", "privacy", "war"],
  "commandKinds": [
    "GuildCreate",
    "GuildInvite",
    "GuildAcceptInvite",
    "GuildDeclineInvite",
    "GuildLeave",
    "GuildKick",
    "GuildSetRole",
    "GuildSetPermissions",
    "GuildTransferLeadership",
    "GuildDeclareWar",
    "GuildAcceptWar",
    "GuildRescindWar",
    "GuildDisband"
  ],
  "actors": {
    "alpha": { "character": "fixture:alpha" },
    "beta": { "character": "fixture:beta" },
    "gamma": { "character": "fixture:gamma" },
    "delta": { "character": "fixture:delta" }
  },
  "steps": [
    { "send": { "actor": "alpha", "line": "/guild-create name=\"Dustgate Wardens\" tag=DUST terminal_prop_id=dustgate-pa-terminal", "as": "createWardens" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.createWardens.data.commandId", "commandKind": "GuildCreate", "accepted": true }, "as": "createWardensReceipt" } },
    { "query": { "actor": "alpha", "line": "/wallet", "as": "alphaWalletAfterCharter" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaWalletAfterCharter", "path": "data.credits", "op": "eq", "value": 50000 } },
    { "send": { "actor": "delta", "line": "/guild-create name=\"Rustline Pact\" tag=RUST terminal_prop_id=dustgate-pa-terminal", "as": "createRustline" } },
    { "await": { "kind": "receipt", "actor": "delta", "match": { "commandId": "$captures.createRustline.data.commandId", "commandKind": "GuildCreate", "accepted": true }, "as": "createRustlineReceipt" } },
    { "query": { "actor": "delta", "line": "/wallet", "as": "deltaWalletAfterCharter" } },
    { "expect": { "kind": "captureCompare", "capture": "deltaWalletAfterCharter", "path": "data.credits", "op": "eq", "value": 50000 } },
    { "query": { "actor": "gamma", "line": "/guild", "as": "outsiderDirectory" } },
    { "expect": { "kind": "captureCompare", "capture": "outsiderDirectory", "path": "data.guild", "op": "eq", "value": null } },
    { "expect": { "kind": "captureCompare", "capture": "outsiderDirectory", "path": "data.roster.length", "op": "eq", "value": 0 } },
    { "await": { "kind": "query", "actor": "gamma", "query": "/guild", "match": { "data.directory": { "includesObject": { "id": "guild-1" } } } } },
    { "send": { "actor": "alpha", "line": "/guild-invite mp-guild-beta", "as": "inviteBeta1" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.inviteBeta1.data.commandId", "commandKind": "GuildInvite", "accepted": true } } },
    { "query": { "actor": "beta", "line": "/guild", "as": "betaPendingInvite" } },
    { "await": { "kind": "query", "actor": "beta", "query": "/guild", "match": { "data.pendingInvites": { "includesObject": { "inviteId": "invite-1", "guildId": "guild-1", "inviterActorId": "mp-guild-alpha" } } } } },
    { "send": { "actor": "beta", "line": "/guild-accept-invite invite-1", "as": "acceptBeta1" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.acceptBeta1.data.commandId", "commandKind": "GuildAcceptInvite", "accepted": true } } },
    { "query": { "actor": "alpha", "line": "/guild", "as": "rosterOnline" } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/guild", "match": { "data.roster": { "includesObject": { "actorId": "mp-guild-alpha", "role": "leader", "online": true, "areaId": "open-desert-overworld" } } } } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/guild", "match": { "data.roster": { "includesObject": { "actorId": "mp-guild-beta", "role": "member", "online": true, "areaId": "open-desert-overworld" } } } } },
    { "send": { "actor": "alpha", "line": "/guild-set-role mp-guild-beta officer", "as": "setBetaOfficer" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.setBetaOfficer.data.commandId", "commandKind": "GuildSetRole", "accepted": true } } },
    { "send": { "actor": "alpha", "line": "/guild-set-permissions mp-guild-beta 9", "as": "setBetaPermissions" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.setBetaPermissions.data.commandId", "commandKind": "GuildSetPermissions", "accepted": true } } },
    { "query": { "actor": "beta", "line": "/guild", "as": "betaRolePermissions" } },
    { "await": { "kind": "query", "actor": "beta", "query": "/guild", "match": { "data.roster": { "includesObject": { "actorId": "mp-guild-beta", "role": "officer", "permissions": ["invite", "war"] } } } } },
    { "send": { "actor": "alpha", "line": "/guild-transfer-leadership mp-guild-beta", "as": "transferToBeta" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.transferToBeta.data.commandId", "commandKind": "GuildTransferLeadership", "accepted": true } } },
    { "send": { "actor": "beta", "line": "/guild-transfer-leadership mp-guild-alpha", "as": "transferBackAlpha" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.transferBackAlpha.data.commandId", "commandKind": "GuildTransferLeadership", "accepted": true } } },
    { "send": { "actor": "alpha", "line": "/guild-invite mp-guild-gamma", "as": "inviteGamma" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.inviteGamma.data.commandId", "commandKind": "GuildInvite", "accepted": true } } },
    { "send": { "actor": "gamma", "line": "/guild-decline-invite invite-2", "as": "declineGamma" } },
    { "await": { "kind": "receipt", "actor": "gamma", "match": { "commandId": "$captures.declineGamma.data.commandId", "commandKind": "GuildDeclineInvite", "accepted": true } } },
    { "chatConnect": { "actor": "alpha", "as": "alphaChat" } },
    { "chatConnect": { "actor": "beta", "as": "betaChat" } },
    { "chatConnect": { "actor": "gamma", "as": "gammaChat" } },
    { "chatConnect": { "actor": "delta", "as": "deltaChat" } },
    { "chatSend": { "client": "alphaChat", "channel": "guild", "body": "wardens-online", "as": "alphaGuildChat" } },
    { "await": { "kind": "chat", "client": "betaChat", "match": { "type": "chat.message", "message.channel": "guild", "message.body": "wardens-online", "message.sender.id": "mp-guild-alpha" } } },
    { "expect": { "kind": "chatEnvelopeCount", "client": "gammaChat", "match": { "type": "chat.message", "message.channel": "guild", "message.body": "wardens-online" }, "op": "eq", "value": 0 } },
    { "disconnect": { "actor": "beta", "as": "betaOffline" } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/guild", "match": { "data.roster": { "includesObject": { "actorId": "mp-guild-beta", "role": "officer", "online": false, "areaId": null, "lastSeenTick": { "op": "exists", "value": true } } } }, "as": "offlineScrubbed" } },
    { "reconnect": { "actor": "beta", "as": "betaReconnect" } },
    { "restart": { "as": "restartEvidence", "timeoutMs": 30000 } },
    { "expect": { "kind": "captureCompare", "capture": "restartEvidence", "path": "oldProcess.mainPid", "op": "exists", "value": true } },
    { "expect": { "kind": "captureCompare", "capture": "restartEvidence", "path": "newProcess.mainPid", "op": "ne", "value": "$captures.restartEvidence.oldProcess.mainPid" } },
    { "query": { "actor": "alpha", "line": "/guild", "as": "restoredGuild" } },
    { "expect": { "kind": "captureCompare", "capture": "restoredGuild", "path": "data.guild.name", "op": "eq", "value": "Dustgate Wardens" } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/guild", "match": { "data.roster": { "includesObject": { "actorId": "mp-guild-beta", "role": "officer", "permissions": ["invite", "war"] } } } } },
    { "send": { "actor": "alpha", "line": "/guild-declare-war guild-2", "as": "declareWar" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.declareWar.data.commandId", "commandKind": "GuildDeclareWar", "accepted": true } } },
    { "chatConnect": { "actor": "alpha", "as": "alphaChat2" } },
    { "chatConnect": { "actor": "beta", "as": "betaChat2" } },
    { "chatConnect": { "actor": "gamma", "as": "gammaChat2" } },
    { "chatConnect": { "actor": "delta", "as": "deltaChat2" } },
    { "chatSend": { "client": "alphaChat2", "channel": "guild", "body": "wardens-restarted", "as": "alphaGuildChat2" } },
    { "await": { "kind": "chat", "client": "betaChat2", "match": { "type": "chat.message", "message.channel": "guild", "message.body": "wardens-restarted", "message.sender.id": "mp-guild-alpha" } } },
    { "expect": { "kind": "chatEnvelopeCount", "client": "gammaChat2", "match": { "type": "chat.message", "message.channel": "guild", "message.body": "wardens-restarted" }, "op": "eq", "value": 0 } },
    { "send": { "actor": "delta", "line": "/guild-accept-war guild-1", "as": "acceptWar" } },
    { "await": { "kind": "receipt", "actor": "delta", "match": { "commandId": "$captures.acceptWar.data.commandId", "commandKind": "GuildAcceptWar", "accepted": true } } },
    { "send": { "actor": "alpha", "line": "/guild-rescind-war guild-2", "as": "rescindWar" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.rescindWar.data.commandId", "commandKind": "GuildRescindWar", "accepted": true } } },
    { "send": { "actor": "beta", "line": "/guild-leave", "as": "betaLeave" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.betaLeave.data.commandId", "commandKind": "GuildLeave", "accepted": true } } },
    { "chatSend": { "client": "betaChat2", "channel": "guild", "body": "after-leave", "expectDelivery": false, "as": "betaChatAfterLeave" } },
    { "expect": { "kind": "captureCompare", "capture": "betaChatAfterLeave", "path": "type", "op": "eq", "value": "chat.error" } },
    { "expect": { "kind": "captureCompare", "capture": "betaChatAfterLeave", "path": "code", "op": "eq", "value": "no_guild" } },
    { "send": { "actor": "alpha", "line": "/guild-invite mp-guild-beta", "as": "inviteBeta2" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.inviteBeta2.data.commandId", "commandKind": "GuildInvite", "accepted": true } } },
    { "send": { "actor": "beta", "line": "/guild-accept-invite invite-3", "as": "acceptBeta2" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.acceptBeta2.data.commandId", "commandKind": "GuildAcceptInvite", "accepted": true } } },
    { "send": { "actor": "alpha", "line": "/guild-kick mp-guild-beta", "as": "kickBeta" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.kickBeta.data.commandId", "commandKind": "GuildKick", "accepted": true } } },
    { "chatSend": { "client": "betaChat2", "channel": "guild", "body": "after-kick", "expectDelivery": false, "as": "betaChatAfterKick" } },
    { "expect": { "kind": "captureCompare", "capture": "betaChatAfterKick", "path": "code", "op": "eq", "value": "no_guild" } },
    { "send": { "actor": "alpha", "line": "/guild-invite mp-guild-beta", "as": "inviteBeta3" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.inviteBeta3.data.commandId", "commandKind": "GuildInvite", "accepted": true } } },
    { "send": { "actor": "beta", "line": "/guild-accept-invite invite-4", "as": "acceptBeta3" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.acceptBeta3.data.commandId", "commandKind": "GuildAcceptInvite", "accepted": true } } },
    { "send": { "actor": "alpha", "line": "/guild-disband", "as": "disbandGuild" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.disbandGuild.data.commandId", "commandKind": "GuildDisband", "accepted": true } } },
    { "query": { "actor": "alpha", "line": "/guild", "as": "postDisbandAlpha" } },
    { "expect": { "kind": "captureCompare", "capture": "postDisbandAlpha", "path": "data.guild", "op": "eq", "value": null } },
    { "expect": { "kind": "captureCompare", "capture": "postDisbandAlpha", "path": "data.roster.length", "op": "eq", "value": 0 } },
    { "chatSend": { "client": "alphaChat2", "channel": "guild", "body": "after-disband-alpha", "expectDelivery": false, "as": "alphaChatAfterDisband" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaChatAfterDisband", "path": "code", "op": "eq", "value": "no_guild" } },
    { "chatSend": { "client": "betaChat2", "channel": "guild", "body": "after-disband-beta", "expectDelivery": false, "as": "betaChatAfterDisband" } },
    { "expect": { "kind": "captureCompare", "capture": "betaChatAfterDisband", "path": "code", "op": "eq", "value": "no_guild" } }
  ],
  "notes": "Runtime proof is intentionally gated on regenerated world content: the checked-in slice currently lacks dustgate-pa-terminal at (509,501). Once that final prop exists, four fixture characters with 300000 credits each charter at the real terminal, exercise all 13 normal Guild* authority commands, verify exact 250000 debits, member-only roster presence/location privacy, offline location scrubbing, durable restart, second-guild war lifecycle, and dynamic guild-chat revocation after leave/kick/disband."
}
