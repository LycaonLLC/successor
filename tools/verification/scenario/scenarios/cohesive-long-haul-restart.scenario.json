{
  "schema": "successor.scenario.v1",
  "name": "cohesive-long-haul-restart",
  "fixture": "open-desert-cohesive-long-haul",
  "persistence": true,
  "lanes": ["accel"],
  "matrixLanes": ["accel"],
  "limits": { "perStepTimeoutMs": 120000, "maxWallDurationMs": 300000 },
  "actors": {
    "alpha": { "character": "fixture:long-haul" },
    "beta": { "character": "fixture:executioner" }
  },
  "steps": [
    { "query": { "actor": "alpha", "line": "/inv long-haul-player:field-pack", "as": "starterInventory" } },
    { "expect": { "kind": "captureCompare", "capture": "starterInventory", "path": "data.totalStacks", "op": "gte", "value": 1 } },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 496, "y": 512, "toleranceCells": 0.4, "pulseMs": 160, "sprint": false, "maxPulses": 240 } }, "as": "trainerWestBypass" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 505, "y": 509, "toleranceCells": 0.3, "pulseMs": 160, "sprint": false, "maxPulses": 180 } }, "as": "trainerSouthApproach" },
    { "send": { "actor": "alpha", "line": "/toggle-door prop_id=dustgate-commerce-facility", "as": "openCommerceDoor" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.openCommerceDoor.data.commandId", "commandKind": "ToggleDoor", "accepted": true }, "timeoutMs": 10000 } },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 505, "y": 505, "toleranceCells": 0.3, "pulseMs": 160, "sprint": false, "maxPulses": 120 } }, "as": "trainerDoorway" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 509, "y": 504, "toleranceCells": 0.2, "pulseMs": 160, "sprint": false, "maxPulses": 180 } }, "as": "trainerInteriorApproach" },
    { "action": { "name": "trainSkill", "actor": "alpha", "args": { "boxId": "craftsman-novice", "trainerId": "camp-trainer", "move": false } }, "as": "craftsman" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "professions": { "includesObject": { "id": "craftsman", "skillBoxes": { "op": "includes", "value": "craftsman-novice" } } } } }, "timeoutMs": 20000, "as": "skillBudgetMutation" } },
    { "send": { "actor": "alpha", "line": "/request-starter-tool trainer_actor_id=camp-trainer", "as": "requestStarterTool" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.requestStarterTool.data.commandId", "commandKind": "RequestStarterTool", "accepted": true }, "timeoutMs": 10000 } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "long-haul-player:field-pack", "itemId": 3001, "minAvailable": 1 }, "timeoutMs": 10000, "as": "starterFieldMultitool" } },
    { "send": { "actor": "alpha", "line": "/pause 10.2s", "as": "sampleCooldown" } },
    { "send": { "actor": "alpha", "line": "/sample iron", "as": "gatherIron" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.gatherIron.data.commandId", "commandKind": "SampleResource", "accepted": true }, "timeoutMs": 10000 } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "long-haul-player:resource-crate", "itemId": 2001, "minAvailable": 24 }, "timeoutMs": 90000, "as": "gatheredIron" } },
    { "send": { "actor": "alpha", "line": "/stand", "as": "standAfterIron" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.standAfterIron.data.commandId", "commandKind": "SetPosture", "accepted": true }, "timeoutMs": 10000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "posture": "standing" } }, "timeoutMs": 10000 } },
    { "send": { "actor": "alpha", "line": "/pause 10.2s", "as": "copperSampleCooldown" } },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 505, "y": 507, "toleranceCells": 0.4, "pulseMs": 160, "sprint": false, "maxPulses": 120 } }, "as": "trainerExitDoorway" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 505, "y": 517, "toleranceCells": 0.4, "pulseMs": 160, "sprint": false, "maxPulses": 180 } }, "as": "trainerExitSouth" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 506, "y": 537, "toleranceCells": 1.0, "maxPulses": 120 } }, "as": "gatheringApproach" },
    { "send": { "actor": "alpha", "line": "/sample copper", "as": "gatherCopper" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.gatherCopper.data.commandId", "commandKind": "SampleResource", "accepted": true }, "timeoutMs": 10000 } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "long-haul-player:resource-crate", "itemId": 2007, "minAvailable": 1 }, "timeoutMs": 90000, "as": "gatheredCopper" } },
    { "send": { "actor": "alpha", "line": "/stand", "as": "standAfterCopper" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.standAfterCopper.data.commandId", "commandKind": "SetPosture", "accepted": true }, "timeoutMs": 10000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "posture": "standing" } }, "timeoutMs": 10000 } },
    { "action": { "name": "craftRecipe", "actor": "alpha", "args": { "recipeId": "mineral_survey_tool", "slots": [{ "slotIndex": 0, "itemId": 2001, "minAvailable": 24 }, { "slotIndex": 1, "itemId": 2007, "minAvailable": 12 }], "outputItemId": 3008 } }, "as": "craftedSurveyTool" },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "long-haul-player:crafted-gear", "itemId": 3008, "minAvailable": 1, "match": { "variantId": { "op": "exists", "value": true } } }, "timeoutMs": 20000, "as": "craftQuality" } },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 496, "y": 517, "toleranceCells": 0.4, "pulseMs": 160, "sprint": false, "maxPulses": 180 } }, "as": "combatWestBypassSouth" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 496, "y": 512, "toleranceCells": 0.4, "pulseMs": 160, "sprint": false, "maxPulses": 120 } }, "as": "combatWestBypassNorth" },
    { "action": { "name": "moveTo", "actor": "alpha", "args": { "x": 513, "y": 512, "toleranceCells": 0.8, "maxPulses": 120 } }, "as": "combatApproach" },
    { "action": { "name": "moveTo", "actor": "beta", "args": { "x": 540, "y": 517, "toleranceCells": 0.4, "pulseMs": 160, "sprint": false, "maxPulses": 120 } }, "as": "executionerSouthBypassEast" },
    { "action": { "name": "moveTo", "actor": "beta", "args": { "x": 516, "y": 517, "toleranceCells": 0.4, "pulseMs": 160, "sprint": false, "maxPulses": 240 } }, "as": "executionerSouthBypassWest" },
    { "action": { "name": "moveTo", "actor": "beta", "args": { "x": 516, "y": 512, "toleranceCells": 0.6, "pulseMs": 160, "sprint": false, "maxPulses": 120 } }, "as": "deathEncounterApproach" },
    { "send": { "actor": "beta", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "executionerEquip" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.executionerEquip.data.commandId", "commandKind": "SetEquippedWeapon", "accepted": true }, "timeoutMs": 10000 } },
    { "send": { "actor": "alpha", "line": "/duel-challenge long-haul-executioner", "as": "firstDuelChallenge" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.firstDuelChallenge.data.commandId", "commandKind": "DuelChallenge", "accepted": true }, "timeoutMs": 10000 } },
    { "send": { "actor": "beta", "line": "/duel-accept", "as": "firstDuelAccept" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.firstDuelAccept.data.commandId", "commandKind": "DuelAccept", "accepted": true }, "timeoutMs": 10000 } },
    { "action": { "name": "attackUntilDowned", "actor": "beta", "args": { "targetId": "long-haul-player", "maxTicks": 1800, "pollTicks": 15, "approachRangeCells": 2.0 } }, "as": "firstIncap" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "lifeState": "downed", "bodyVanishTick": 0 } }, "timeoutMs": 30000, "as": "firstIncapPreserved" } },
    { "send": { "actor": "alpha", "line": "/pause 25s", "as": "firstSelfReviveWindow" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "lifeState": "alive" } }, "timeoutMs": 30000, "as": "firstSelfRevive" } },
    { "action": { "name": "attackUntilDowned", "actor": "beta", "args": { "targetId": "long-haul-player", "maxTicks": 1800, "pollTicks": 15, "approachRangeCells": 2.0 } }, "as": "secondIncap" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "lifeState": "downed", "bodyVanishTick": 0 } }, "timeoutMs": 30000, "as": "secondIncapPreserved" } },
    { "send": { "actor": "alpha", "line": "/pause 25s", "as": "secondSelfReviveWindow" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "lifeState": "alive" } }, "timeoutMs": 30000, "as": "secondSelfRevive" } },
    { "action": { "name": "attackUntilCloneEligible", "actor": "beta", "args": { "targetId": "long-haul-player", "maxTicks": 1800, "pollTicks": 15, "approachRangeCells": 2.0 } }, "as": "lethalIncap" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "lifeState": "respawning", "vitals.health": 0, "respawnAtTick": { "op": "gt", "value": 0 } } }, "timeoutMs": 30000, "as": "playerDeath" } },
    { "send": { "actor": "alpha", "line": "/clone dustgate-cloning-facility", "as": "cloneRespawn" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.cloneRespawn.data.commandId", "commandKind": "CloneRespawn", "accepted": true }, "timeoutMs": 20000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "lifeState": "alive", "cloneSicknessRemainingMs": { "op": "gt", "value": 0 } } }, "timeoutMs": 30000, "as": "cloned" } },
    { "restart": { "as": "restartEvidence", "timeoutMs": 30000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.alpha.id", "match": { "lifeState": "alive", "cloneSicknessRemainingMs": "$captures.cloned.cloneSicknessRemainingMs", "vitals.action": "$captures.cloned.vitals.action" } } , "timeoutMs": 20000, "as": "exactPersistedClone" } },
    { "query": { "actor": "alpha", "line": "/where", "as": "continuedAction" } },
    { "expect": { "kind": "captureCompare", "capture": "continuedAction", "path": "data.source", "op": "eq", "value": "server" } },
    { "expect": { "kind": "commandStreamNoMatch", "match": { "commandKind": { "regex": "^Debug" } } } }
  ],
  "notes": "First-entry starter, skill allocation, real sampling, crafted survey tool variant, hostile combat death, explicit clone, checkpoint/restart, exact clone-state persistence, reconnect, and useful post-restart query."
}
