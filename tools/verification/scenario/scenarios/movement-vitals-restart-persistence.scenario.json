{
  "schema": "successor.scenario.v1",
  "name": "movement-vitals-restart-persistence",
  "fixture": "open-desert-core-world-restart",
  "lanes": ["accel"],
  "matrixLanes": ["accel"],
  "persistence": true,
  "actors": {
    "core": { "character": "fixture:core" }
  },
  "steps": [
    { "send": { "actor": "core", "line": "/kneel", "as": "kneelBeforeRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.kneelBeforeRestart.data.commandId", "commandKind": "SetPosture", "accepted": true }, "timeoutMs": 10000, "as": "kneelReceipt" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.core.id", "match": { "posture": "kneeling", "lifeState": "alive" } }, "timeoutMs": 10000, "as": "kneelingBeforeRestart" } },
    { "send": { "actor": "core", "line": "/stand", "as": "standBeforeRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.standBeforeRestart.data.commandId", "commandKind": "SetPosture", "accepted": true }, "timeoutMs": 10000, "as": "standReceipt" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.core.id", "match": { "posture": "standing", "lifeState": "alive" } }, "timeoutMs": 10000, "as": "standingBeforeRestart" } },
    { "action": { "name": "moveTo", "actor": "core", "args": { "x": 530, "y": 520, "toleranceCells": 0.8 } }, "as": "campApproachBeforeRestart" },
    { "send": { "actor": "core", "line": "/place-camp", "as": "campBeforeRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.campBeforeRestart.data.commandId", "commandKind": "PlaceCamp", "accepted": true }, "timeoutMs": 10000, "as": "campReceipt" } },
    { "await": { "kind": "oracle", "condition": { "placedCamps[0].campId": { "op": "exists", "value": true }, "placedCamps[0].areaId": "open-desert-overworld", "placedCamps[0].renderKind": "scout-camp" }, "timeoutMs": 10000, "as": "campStateBeforeRestart" } },
    { "send": { "actor": "core", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "equipBeforeRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.equipBeforeRestart.data.commandId", "commandKind": "SetEquippedWeapon", "accepted": true }, "timeoutMs": 10000, "as": "equipReceipt" } },
    { "action": { "name": "attackUntilDowned", "actor": "core", "args": { "targetId": "core-restart-patient", "maxTicks": 900, "pollTicks": 15, "approachRangeCells": 1.5 } }, "as": "incapBeforeRestart" },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "core-restart-patient", "match": { "lifeState": "downed", "vitals.health": 0 } }, "timeoutMs": 12000, "as": "incapStateBeforeRestart" } },
    { "send": { "actor": "core", "line": "/apply-service-buff effect_id=medic_prep", "as": "buffBeforeRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.buffBeforeRestart.data.commandId", "commandKind": "ApplyServiceBuff", "accepted": true }, "timeoutMs": 10000, "as": "buffReceipt" } },
    { "query": { "actor": "core", "line": "/where", "as": "positionBeforeRestart" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.core.id", "match": { "areaId": "open-desert-overworld", "x": "$captures.positionBeforeRestart.data.x", "y": "$captures.positionBeforeRestart.data.y", "posture": "standing", "lifeState": "alive", "vitals.health": 170, "maxVitals.health": 170, "statuses": { "includesObject": { "id": "medic-prep" } } } }, "timeoutMs": 12000, "as": "movementVitalsBeforeRestart" } },
    { "send": { "actor": "core", "line": "/set-move-intent -1 0 Left false", "alignTick": false, "as": "heldIntentBeforeRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.heldIntentBeforeRestart.data.commandId", "commandKind": "SetMoveIntent", "accepted": true }, "timeoutMs": 10000, "as": "heldIntentReceipt" } },
    { "restart": { "as": "restartEvidence", "timeoutMs": 30000 } },
    { "expect": { "kind": "captureCompare", "capture": "restartEvidence", "path": "oldProcess.mainPid", "op": "exists", "value": true, "as": "oldProcessIdentity" } },
    { "expect": { "kind": "captureCompare", "capture": "restartEvidence", "path": "newProcess.mainPid", "op": "ne", "value": "$captures.restartEvidence.oldProcess.mainPid", "as": "newProcessIdentity" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.core.id", "match": { "areaId": "$captures.movementVitalsBeforeRestart.areaId", "x": { "op": "lt", "value": "$captures.movementVitalsBeforeRestart.x" }, "direction": "left", "posture": "$captures.movementVitalsBeforeRestart.posture", "lifeState": "$captures.movementVitalsBeforeRestart.lifeState", "vitals.health": "$captures.movementVitalsBeforeRestart.vitals.health", "vitals.spirit": "$captures.movementVitalsBeforeRestart.vitals.spirit", "maxVitals.health": "$captures.movementVitalsBeforeRestart.maxVitals.health", "maxVitals.action": "$captures.movementVitalsBeforeRestart.maxVitals.action", "statuses": { "includesObject": { "id": "medic-prep" } } } }, "timeoutMs": 15000, "as": "movementVitalsAfterRestart" } },
    { "expect": { "kind": "captureCompare", "capture": "movementVitalsAfterRestart", "path": "posture", "op": "eq", "value": "$captures.movementVitalsBeforeRestart.posture", "as": "postureExact" } },
    { "expect": { "kind": "captureCompare", "capture": "movementVitalsAfterRestart", "path": "vitals.health", "op": "eq", "value": "$captures.movementVitalsBeforeRestart.vitals.health", "as": "woundExact" } },
    { "expect": { "kind": "captureCompare", "capture": "movementVitalsAfterRestart", "path": "statuses[0].id", "op": "eq", "value": "medic-prep", "as": "buffExact" } },
    { "await": { "kind": "oracle", "condition": { "propStates.open-desert-shelter-house.doorOpen": { "op": "exists", "value": true }, "placedCamps[0].campId": "$captures.campStateBeforeRestart.placedCamps.0.campId", "placedCamps[0].areaId": "$captures.campStateBeforeRestart.placedCamps.0.areaId", "placedCamps[0].cellX": "$captures.campStateBeforeRestart.placedCamps.0.cellX", "placedCamps[0].cellY": "$captures.campStateBeforeRestart.placedCamps.0.cellY", "placedCamps[0].renderKind": "$captures.campStateBeforeRestart.placedCamps.0.renderKind" }, "timeoutMs": 15000, "as": "campAfterRestart" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "core-restart-patient", "match": { "lifeState": "downed", "vitals.health": 0 } }, "timeoutMs": 15000, "as": "incapAfterRestart" } },
    { "send": { "actor": "core", "line": "/set-move-intent 0 0 Left false", "as": "clearHeldIntentAfterRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.clearHeldIntentAfterRestart.data.commandId", "commandKind": "SetMoveIntent", "accepted": true }, "timeoutMs": 10000, "as": "clearHeldIntentReceipt" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "$actors.core.id", "match": { "posture": "$captures.movementVitalsBeforeRestart.posture", "lifeState": "alive" } }, "timeoutMs": 10000, "as": "heldIntentClearedAfterRestart" } },
    { "action": { "name": "moveTo", "actor": "core", "args": { "x": 523, "y": 512, "toleranceCells": 0.4, "maxPulses": 120, "pulseMs": 80, "sprint": false } }, "as": "reviveApproachAfterRestart" },
    { "expect": { "kind": "captureCompare", "capture": "reviveApproachAfterRestart", "path": "result.distanceCells", "op": "lte", "value": 0.8, "as": "reviveProximity" } },
    { "send": { "actor": "core", "line": "/revive-actor target_actor_id=core-restart-patient", "as": "reviveAfterRestart" } },
    { "await": { "kind": "receipt", "actor": "core", "match": { "commandId": "$captures.reviveAfterRestart.data.commandId", "commandKind": "ReviveActor", "accepted": true }, "timeoutMs": 10000, "as": "reviveReceipt" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "core-restart-patient", "match": { "lifeState": "alive", "vitals.health": { "op": "gt", "value": 0 } } }, "timeoutMs": 12000, "as": "revivedAfterRestart" } },
    { "expect": { "kind": "commandStreamNoMatch", "match": { "commandKind": { "regex": "^Debug" } }, "as": "noDebugCommands" } }
  ],
  "notes": "Bounded movement/vitals restart proof. Kneel/stand establishes posture, a real terminal approach and camp placement establish the durable camp anchor, the fixture's wounded player is captured with a medic-prep service buff, and live authority combat incapacitates the authored patient. Facing, posture, wounded health, buff status, camp identity/location, and patient downed state are captured before one ProcessHost restart and asserted after reconnect with distinct process IDs. The held SetMoveIntent is durable authority state: after reconnect the actor must resume bounded leftward displacement with the same posture and vitals before an accepted zero-vector command clears the intent. The persisted downed patient is then revived through the accepted post-restart ReviveActor receipt."
}
