{
  "schema": "successor.scenario.v1",
  "name": "gaia-party-rights-restart",
  "fixture": "open-desert-gaia-party-rights",
  "persistence": true,
  "lanes": ["accel", "realtime"],
  "matrixLanes": ["accel"],
  "realtimeReason": "Gaia damage-ledger arbitration and restart-frozen harvest rights are multiplayer realtime contracts.",
  "tags": ["gaia", "groups", "harvest", "loot", "restart"],
  "actors": {
    "winnerA": { "character": "fixture:winnerA" },
    "winnerB": { "character": "fixture:winnerB" },
    "winnerNoncontributor": { "character": "fixture:winnerNoncontributor" },
    "loser": { "character": "fixture:loser" },
    "loserMember": { "character": "fixture:loserMember" }
  },
  "steps": [
    { "send": { "actor": "winnerA", "line": "/group-invite winner-b", "as": "inviteWinnerB" } },
    { "await": { "kind": "receipt", "actor": "winnerA", "match": { "commandId": "$captures.inviteWinnerB.data.commandId", "commandKind": "GroupInvite", "accepted": true }, "timeoutMs": 12000 } },
    { "send": { "actor": "winnerB", "line": "/group-accept", "as": "acceptWinnerB" } },
    { "await": { "kind": "receipt", "actor": "winnerB", "match": { "commandId": "$captures.acceptWinnerB.data.commandId", "commandKind": "GroupAccept", "accepted": true }, "timeoutMs": 12000 } },
    { "send": { "actor": "winnerA", "line": "/group-invite winner-noncontributor", "as": "inviteWinnerNoncontributor" } },
    { "send": { "actor": "winnerNoncontributor", "line": "/group-accept", "as": "acceptWinnerNoncontributor" } },
    { "await": { "kind": "receipt", "actor": "winnerNoncontributor", "match": { "commandId": "$captures.acceptWinnerNoncontributor.data.commandId", "commandKind": "GroupAccept", "accepted": true }, "timeoutMs": 12000 } },
    { "send": { "actor": "loser", "line": "/group-invite loser-member", "as": "inviteLoserMember" } },
    { "send": { "actor": "loserMember", "line": "/group-accept", "as": "acceptLoserMember" } },
    { "await": { "kind": "receipt", "actor": "loserMember", "match": { "commandId": "$captures.acceptLoserMember.data.commandId", "commandKind": "GroupAccept", "accepted": true }, "timeoutMs": 12000 } },
    { "parallel": [
      { "actor": "winnerA", "steps": [ { "send": { "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "winnerAEquip" } }, { "send": { "line": "/target open-desert-bellback-01-01", "as": "winnerATarget" } }, { "send": { "line": "/attack", "as": "winnerAAttack" } } ] },
      { "actor": "winnerB", "steps": [ { "send": { "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "winnerBEquip" } }, { "send": { "line": "/target open-desert-bellback-01-01", "as": "winnerBTarget" } }, { "send": { "line": "/attack", "as": "winnerBAttack" } } ] }
    ] },
    { "await": { "kind": "receipt", "actor": "winnerA", "match": { "commandId": "$captures.winnerAEquip.data.commandId", "commandKind": "SetEquippedWeapon", "accepted": true }, "timeoutMs": 12000 } },
    { "await": { "kind": "receipt", "actor": "winnerB", "match": { "commandId": "$captures.winnerBEquip.data.commandId", "commandKind": "SetEquippedWeapon", "accepted": true }, "timeoutMs": 12000 } },
    { "await": { "kind": "receipt", "actor": "winnerA", "match": { "commandId": "$captures.winnerAAttack.data.commandId", "commandKind": "QueueCombatAction", "accepted": true }, "timeoutMs": 12000 } },
    { "await": { "kind": "receipt", "actor": "winnerB", "match": { "commandId": "$captures.winnerBAttack.data.commandId", "commandKind": "QueueCombatAction", "accepted": true }, "timeoutMs": 12000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "open-desert-bellback-01-01", "match": { "factionId": "gaia", "role": "creature", "lifeState": "downed" } }, "timeoutMs": 120000, "as": "bellbackCorpse" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "winner-a", "match": { "professions": { "includesObject": { "id": "marksman", "trackXp.rifle": { "op": "gt", "value": 0 } } } } }, "timeoutMs": 20000, "as": "winnerAKillXp" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "winner-b", "match": { "professions": { "includesObject": { "id": "marksman", "trackXp.rifle": { "op": "gt", "value": 0 } } } } }, "timeoutMs": 20000, "as": "winnerBKillXp" } },
    { "expect": { "kind": "captureCompare", "capture": "winnerBKillXp", "path": "professions[0].trackXp.rifle", "op": "eq", "value": "$captures.winnerAKillXp.professions[0].trackXp.rifle" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "winner-noncontributor", "match": { "professions": { "includesObject": { "id": "marksman", "trackXp.rifle": { "exists": false } } } } }, "timeoutMs": 15000, "as": "noncontributorZeroXp" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "loser", "match": { "professions": { "includesObject": { "id": "marksman", "trackXp.rifle": { "exists": false } } } } }, "timeoutMs": 15000, "as": "loserZeroXp" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "winner-noncontributor", "match": { "professions": { "includesObject": { "id": "scout", "trackXp.creature-harvesting": { "exists": false } } } } }, "timeoutMs": 15000, "as": "noncontributorZeroHarvestXp" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "loser", "match": { "professions": { "includesObject": { "id": "scout", "trackXp.creature-harvesting": { "exists": false } } } } }, "timeoutMs": 15000, "as": "loserZeroHarvestXp" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "loser-member", "match": { "professions": { "includesObject": { "id": "scout", "trackXp.creature-harvesting": { "exists": false } } } } }, "timeoutMs": 15000, "as": "loserMemberZeroHarvestXp" } },
    { "action": { "name": "harvestCorpse", "actor": "winnerA", "args": { "targetId": "open-desert-bellback-01-01" } }, "as": "winnerAHarvest" },
    { "send": { "actor": "winnerA", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "postWinnerAHarvestEquip" } },
    { "restart": { "as": "rightsRestart", "timeoutMs": 30000 } },
    { "send": { "actor": "winnerB", "line": "/harvest-corpse target_actor_id=open-desert-bellback-01-01", "as": "winnerBHarvest" } },
    { "await": { "kind": "receipt", "actor": "winnerB", "match": { "commandId": "$captures.winnerBHarvest.data.commandId", "commandKind": "HarvestCorpse", "accepted": true }, "timeoutMs": 12000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "winner-a", "match": { "professions": { "includesObject": { "id": "scout", "trackXp.creature-harvesting": { "op": "gt", "value": 0 } } } } }, "timeoutMs": 20000, "as": "winnerAHarvestXp" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "winner-a:creature-structural", "itemId": 2101, "minAvailable": 1 }, "timeoutMs": 20000, "as": "winnerAHide" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "winner-b:creature-structural", "itemId": 2101, "minAvailable": 1 }, "timeoutMs": 20000, "as": "winnerBHide" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "winner-a:creature-food", "itemId": 2102, "minAvailable": 1 }, "timeoutMs": 20000, "as": "winnerAMeat" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "winner-b:creature-food", "itemId": 2102, "minAvailable": 1 }, "timeoutMs": 20000, "as": "winnerBMeat" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "winner-a:creature-structural", "itemId": 2103, "minAvailable": 1 }, "timeoutMs": 20000, "as": "winnerABone" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "winner-b:creature-structural", "itemId": 2103, "minAvailable": 1 }, "timeoutMs": 20000, "as": "winnerBBone" } },
    { "expect": { "kind": "captureCompare", "capture": "winnerAHide", "path": "available", "op": "eq", "value": "$captures.winnerAHide.quantity" } },
    { "expect": { "kind": "captureCompare", "capture": "winnerAMeat", "path": "available", "op": "eq", "value": "$captures.winnerAMeat.quantity" } },
    { "expect": { "kind": "captureCompare", "capture": "winnerABone", "path": "available", "op": "eq", "value": "$captures.winnerABone.quantity" } },
    { "expect": { "kind": "captureCompare", "capture": "winnerBHide", "path": "available", "op": "eq", "value": "$captures.winnerAHide.available" } },
    { "expect": { "kind": "captureCompare", "capture": "winnerBMeat", "path": "available", "op": "eq", "value": "$captures.winnerAMeat.available" } },
    { "expect": { "kind": "captureCompare", "capture": "winnerBBone", "path": "available", "op": "eq", "value": "$captures.winnerABone.available" } },
    { "query": { "actor": "winnerNoncontributor", "line": "/inv 2101", "as": "noncontributorHide" } },
    { "query": { "actor": "winnerNoncontributor", "line": "/inv 2102", "as": "noncontributorMeat" } },
    { "query": { "actor": "winnerNoncontributor", "line": "/inv 2103", "as": "noncontributorBone" } },
    { "query": { "actor": "loser", "line": "/inv 2101", "as": "loserHide" } },
    { "query": { "actor": "loser", "line": "/inv 2102", "as": "loserMeat" } },
    { "query": { "actor": "loser", "line": "/inv 2103", "as": "loserBone" } },
    { "query": { "actor": "loserMember", "line": "/inv 2101", "as": "loserMemberHide" } },
    { "query": { "actor": "loserMember", "line": "/inv 2102", "as": "loserMemberMeat" } },
    { "query": { "actor": "loserMember", "line": "/inv 2103", "as": "loserMemberBone" } },
    { "expect": { "kind": "captureCompare", "capture": "noncontributorHide", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "noncontributorMeat", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "noncontributorBone", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "loserHide", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "loserMeat", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "loserBone", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "loserMemberHide", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "loserMemberMeat", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "expect": { "kind": "captureCompare", "capture": "loserMemberBone", "path": "data.totalStacks", "op": "eq", "value": 0 } },
    { "send": { "actor": "winnerA", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "postWinnerBClaimEquip" } },
    { "send": { "actor": "winnerA", "line": "/harvest-corpse target_actor_id=open-desert-bellback-01-01", "as": "duplicateHarvest" } },
    { "await": { "kind": "receipt", "actor": "winnerA", "match": { "commandId": "$captures.duplicateHarvest.data.commandId", "commandKind": "HarvestCorpse", "accepted": false }, "timeoutMs": 12000 } },
    { "send": { "actor": "loser", "line": "/equip-weapon weapon_id=slugthrower weapon_item_id=3101", "as": "postDuplicateLoserEquip" } },
    { "send": { "actor": "loser", "line": "/harvest-corpse target_actor_id=open-desert-bellback-01-01", "as": "loserHarvest" } },
    { "await": { "kind": "receipt", "actor": "loser", "match": { "commandId": "$captures.loserHarvest.data.commandId", "commandKind": "HarvestCorpse", "accepted": false }, "timeoutMs": 12000 } }
  ],
  "notes": "Generated Gaia bellback zone: winnerA and winnerB are grouped contributors with equal full yields (2101/2102/2103) and equal Scout harvest XP; noncontributors and loser party have zero XP/material rows. Restart occurs between the first and second winner claims; duplicate and loser claims are denied after durable rights persistence."
}
