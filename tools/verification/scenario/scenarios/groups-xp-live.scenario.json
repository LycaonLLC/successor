{
  "schema": "successor.scenario.v1",
  "name": "groups-xp-live",
  "fixture": "open-desert-multiplayer-assist",
  "actors": {
    "alpha": { "character": "fixture:alpha" },
    "beta": { "character": "fixture:beta" }
  },
  "steps": [
    { "command": { "actor": "alpha", "body": { "DebugGrantSkillBoxes": { "skill_box_ids": ["marksman-novice"] } }, "as": "alphaGrantMarksman" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaGrantMarksman", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "alpha", "body": { "DebugGiveItem": { "item_id": 3101, "variant_id": 0, "quantity": 1, "equip": true } }, "as": "alphaGiveSlugthrower" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaGiveSlugthrower", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "alpha", "body": { "DebugGiveItem": { "item_id": 1101, "variant_id": 0, "quantity": 240, "equip": false } }, "as": "alphaGiveAmmo" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaGiveAmmo", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "DebugGrantSkillBoxes": { "skill_box_ids": ["marksman-novice"] } }, "as": "betaGrantMarksman" } },
    { "expect": { "kind": "captureCompare", "capture": "betaGrantMarksman", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "DebugGiveItem": { "item_id": 3101, "variant_id": 0, "quantity": 1, "equip": true } }, "as": "betaGiveSlugthrower" } },
    { "expect": { "kind": "captureCompare", "capture": "betaGiveSlugthrower", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "DebugGiveItem": { "item_id": 1101, "variant_id": 0, "quantity": 240, "equip": false } }, "as": "betaGiveAmmo" } },
    { "expect": { "kind": "captureCompare", "capture": "betaGiveAmmo", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/nearby all", "match": { "data.actors[0].id": "mp-assist-rogue", "data.actors[0].lifeState": "alive" }, "timeoutMs": 12000, "intervalMs": 250, "as": "alphaSeesRogue" } },
    { "send": { "actor": "alpha", "line": "/group-invite mp-assist-beta", "as": "alphaInvite" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaInvite.data.commandId", "commandKind": "GroupInvite", "accepted": true }, "timeoutMs": 12000, "as": "alphaInviteReceipt" } },
    { "send": { "actor": "beta", "line": "/group-accept", "as": "betaAccept" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.betaAccept.data.commandId", "commandKind": "GroupAccept", "accepted": true }, "timeoutMs": 12000, "as": "betaAcceptReceipt" } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/group", "match": { "data.members[0].actorId": "mp-assist-alpha", "data.members[1].actorId": "mp-assist-beta", "data.members[0].vitals.health": { "op": "gt", "value": 0 }, "data.members[1].vitals.health": { "op": "gt", "value": 0 } }, "timeoutMs": 12000, "intervalMs": 250, "as": "alphaGroupFrames" } },
    { "await": { "kind": "query", "actor": "beta", "query": "/group", "match": { "data.members[0].actorId": "mp-assist-alpha", "data.members[1].actorId": "mp-assist-beta", "data.group.leaderActorId": "mp-assist-alpha" }, "timeoutMs": 12000, "intervalMs": 250, "as": "betaGroupFrames" } },
    { "send": { "actor": "alpha", "line": "/target mp-assist-rogue", "as": "alphaTarget" } },
    { "send": { "actor": "beta", "line": "/target mp-assist-rogue", "as": "betaTarget" } },
    { "send": { "actor": "alpha", "line": "/attack", "as": "alphaAttack" } },
    { "send": { "actor": "beta", "line": "/attack", "as": "betaAttack" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaAttack.data.commandId", "commandKind": "QueueCombatAction", "accepted": true }, "timeoutMs": 12000, "as": "alphaAttackReceipt" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.betaAttack.data.commandId", "commandKind": "QueueCombatAction", "accepted": true }, "timeoutMs": 12000, "as": "betaAttackReceipt" } },
    { "await": { "kind": "event", "actor": "alpha", "event": "combat", "match": { "data.event.shooterActorId": "mp-assist-alpha", "data.event.targetActorId": "mp-assist-rogue" }, "timeoutMs": 30000, "as": "alphaHit" } },
    { "await": { "kind": "event", "actor": "beta", "event": "combat", "match": { "data.event.shooterActorId": "mp-assist-beta", "data.event.targetActorId": "mp-assist-rogue" }, "timeoutMs": 40000, "as": "betaHit" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-assist-rogue", "match": { "lifeState": "downed" } }, "timeoutMs": 120000, "as": "rogueDowned" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-assist-alpha", "match": { "professions[0].id": "marksman", "professions[0].trackXp.rifle": { "op": "gt", "value": 0 } } }, "timeoutMs": 15000, "as": "alphaState" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-assist-beta", "match": { "professions[0].id": "marksman", "professions[0].trackXp.rifle": { "op": "gt", "value": 0 } } }, "timeoutMs": 15000, "as": "betaState" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-assist-rogue", "match": {} }, "timeoutMs": 5000, "as": "rogueState" } },
    { "expect": { "kind": "captureCompare", "capture": "betaState", "path": "professions[0].trackXp.rifle", "op": "eq", "value": "$captures.alphaState.professions[0].trackXp.rifle" } }
  ],
  "notes": "Two driver sessions form a group through accepted GroupInvite and GroupAccept receipts, both damage the rogue, and both receive full kill-time marksman Slugthrower XP. Combat XP is asserted after the kill because XP is awarded from the kill ledger rather than per hit."
}
