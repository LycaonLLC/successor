{
  "schema": "successor.scenario.v1",
  "name": "social-trade-exchange-restart-persistence",
  "fixture": "open-desert-multiplayer-trade",
  "persistence": true,
  "lanes": ["accel"],
  "tags": ["restart", "groups", "exchange", "trade", "multiplayer"],
  "actors": {
    "alpha": { "character": "fixture:alpha" },
    "beta": { "character": "fixture:beta" },
    "gamma": { "character": "fixture:gamma" }
  },
  "steps": [
    { "await": { "kind": "query", "actor": "alpha", "query": "/nearby all", "match": { "data.actors": { "includesObject": { "id": "mp-trade-beta", "lifeState": "alive" } } }, "timeoutMs": 12000, "intervalMs": 250, "as": "alphaSeesTradeBeta" } },
    { "send": { "actor": "alpha", "line": "/group-invite mp-trade-beta", "as": "inviteBeta" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.inviteBeta.data.commandId", "commandKind": "GroupInvite", "accepted": true }, "timeoutMs": 12000, "as": "inviteBetaReceipt" } },
    { "send": { "actor": "alpha", "line": "/group-invite mp-trade-gamma", "as": "inviteGamma" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.inviteGamma.data.commandId", "commandKind": "GroupInvite", "accepted": true }, "timeoutMs": 12000, "as": "inviteGammaReceipt" } },
    { "await": { "kind": "query", "actor": "beta", "query": "/group", "match": { "data.group": { "op": "notExists", "value": true }, "data.pendingInvite.inviterActorId": "mp-trade-alpha", "data.pendingInvite.inviterName": "TradeAlpha" }, "timeoutMs": 12000, "intervalMs": 250, "as": "pendingBetaBeforeRestart" } },
    { "await": { "kind": "query", "actor": "gamma", "query": "/group", "match": { "data.group": { "op": "notExists", "value": true }, "data.pendingInvite.inviterActorId": "mp-trade-alpha", "data.pendingInvite.inviterName": "TradeAlpha" }, "timeoutMs": 12000, "intervalMs": 250, "as": "pendingGammaBeforeRestart" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-alpha:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 5 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "alphaExchangeBefore" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-beta:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 5 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "betaExchangeBefore" } },
    { "command": { "actor": "alpha", "body": { "StoreToExchange": { "item_id": 2001, "variant_id": 211337, "quantity": 3 } }, "as": "alphaStoreExactIron" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaStoreExactIron", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "StoreToExchange": { "item_id": 2001, "variant_id": 211337, "quantity": 3 } }, "as": "betaStoreExactIron" } },
    { "expect": { "kind": "captureCompare", "capture": "betaStoreExactIron", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "district-exchange", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 6 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "exchangeAggregateBeforeRestart" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-alpha:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 2 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "alphaStoredBeforeRestart" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-beta:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 2 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "betaStoredBeforeRestart" } },
    { "restart": { "as": "restartEvidence", "timeoutMs": 30000 } },
    { "expect": { "kind": "captureCompare", "capture": "restartEvidence", "path": "oldProcess.mainPid", "op": "exists", "value": true } },
    { "expect": { "kind": "captureCompare", "capture": "restartEvidence", "path": "newProcess.mainPid", "op": "ne", "value": "$captures.restartEvidence.oldProcess.mainPid" } },
    { "expect": { "kind": "captureCompare", "capture": "restartEvidence", "path": "checkpoint.checkpoint.tick", "op": "exists", "value": true } },
    { "await": { "kind": "query", "actor": "beta", "query": "/group", "match": { "data.group": { "op": "notExists", "value": true }, "data.pendingInvite.inviterActorId": "mp-trade-alpha", "data.pendingInvite.inviterName": "TradeAlpha" }, "timeoutMs": 12000, "intervalMs": 250, "as": "pendingBetaAfterRestart" } },
    { "await": { "kind": "query", "actor": "gamma", "query": "/group", "match": { "data.group": { "op": "notExists", "value": true }, "data.pendingInvite.inviterActorId": "mp-trade-alpha", "data.pendingInvite.inviterName": "TradeAlpha" }, "timeoutMs": 12000, "intervalMs": 250, "as": "pendingGammaAfterRestart" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "district-exchange", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": "$captures.exchangeAggregateBeforeRestart.available" }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "exchangeAggregateAfterRestart" } },
    { "command": { "actor": "beta", "body": { "GroupAccept": {} }, "as": "acceptRestoredBetaInvite" } },
    { "expect": { "kind": "captureCompare", "capture": "acceptRestoredBetaInvite", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "gamma", "body": { "GroupDecline": {} }, "as": "declineRestoredGammaInvite" } },
    { "expect": { "kind": "captureCompare", "capture": "declineRestoredGammaInvite", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "GroupAccept": {} }, "as": "duplicateBetaAccept" } },
    { "expect": { "kind": "captureCompare", "capture": "duplicateBetaAccept", "path": "receipt.accepted", "op": "eq", "value": false } },
    { "expect": { "kind": "captureCompare", "capture": "duplicateBetaAccept", "path": "receipt.reasonCode", "op": "eq", "value": "no_pending_invite" } },
    { "command": { "actor": "gamma", "body": { "GroupDecline": {} }, "as": "duplicateGammaDecline" } },
    { "expect": { "kind": "captureCompare", "capture": "duplicateGammaDecline", "path": "receipt.accepted", "op": "eq", "value": false } },
    { "expect": { "kind": "captureCompare", "capture": "duplicateGammaDecline", "path": "receipt.reasonCode", "op": "eq", "value": "no_pending_invite" } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/group", "match": { "data.group.leaderActorId": "mp-trade-alpha", "data.group.memberActorIds": { "op": "includes", "value": "mp-trade-alpha" }, "data.members": { "includesObject": { "actorId": "mp-trade-alpha", "name": "TradeAlpha", "isLeader": true } } }, "timeoutMs": 12000, "intervalMs": 250, "as": "formedGroupAlpha" } },
    { "await": { "kind": "query", "actor": "beta", "query": "/group", "match": { "data.group.leaderActorId": "mp-trade-alpha", "data.group.memberActorIds": { "op": "includes", "value": "mp-trade-beta" }, "data.members": { "includesObject": { "actorId": "mp-trade-alpha", "name": "TradeAlpha", "isLeader": true } } }, "timeoutMs": 12000, "intervalMs": 250, "as": "formedGroupBeta" } },
    { "await": { "kind": "query", "actor": "gamma", "query": "/group", "match": { "data.pendingInvite": { "op": "notExists", "value": true } }, "timeoutMs": 12000, "intervalMs": 250, "as": "gammaDeclinedGroup" } },
    { "command": { "actor": "alpha", "body": { "RetrieveFromExchange": { "item_id": 2001, "variant_id": 211337, "quantity": 4 } }, "as": "alphaContendedRetrieve" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaContendedRetrieve", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "RetrieveFromExchange": { "item_id": 2001, "variant_id": 211337, "quantity": 4 } }, "as": "betaContendedRetrieve" } },
    { "expect": { "kind": "captureCompare", "capture": "betaContendedRetrieve", "path": "receipt.accepted", "op": "eq", "value": false } },
    { "expect": { "kind": "captureCompare", "capture": "betaContendedRetrieve", "path": "receipt.reasonCode", "op": "eq", "value": "item_unavailable" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "district-exchange", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 2 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "exchangeAfterWinner" } },
    { "command": { "actor": "beta", "body": { "RetrieveFromExchange": { "item_id": 2001, "variant_id": 211337, "quantity": 2 } }, "as": "betaRetrieveRemainder" } },
    { "expect": { "kind": "captureCompare", "capture": "betaRetrieveRemainder", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-alpha:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 6 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "alphaExchangeAfter" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-beta:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 4 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "betaExchangeAfter" } },
    { "command": { "actor": "alpha", "body": { "DebugGiveItem": { "item_id": 1001, "variant_id": 0, "quantity": 4, "equip": false } }, "as": "giveStimpaks" } },
    { "expect": { "kind": "captureCompare", "capture": "giveStimpaks", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "alpha", "body": { "ProposeTrade": { "partner_actor_id": "mp-trade-beta", "offer": [], "request": [] } }, "as": "proposeTrade" } },
    { "expect": { "kind": "captureCompare", "capture": "proposeTrade", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "alpha", "body": { "AddTradeItem": { "proposal_id": 1, "item": { "item_id": 1001, "variant_id": 0, "quantity": 2 } } }, "as": "alphaAddsTradeStims" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaAddsTradeStims", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "AddTradeItem": { "proposal_id": 1, "item": { "item_id": 2001, "variant_id": 0, "quantity": 3 } } }, "as": "betaAddsTradeIron" } },
    { "expect": { "kind": "captureCompare", "capture": "betaAddsTradeIron", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "alpha", "body": { "AcceptTrade": { "proposal_id": 1 } }, "as": "alphaLock" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaLock", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "command": { "actor": "beta", "body": { "AcceptTrade": { "proposal_id": 1 } }, "as": "betaLock" } },
    { "expect": { "kind": "captureCompare", "capture": "betaLock", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "await": { "kind": "event", "actor": "alpha", "event": "trade_session", "match": { "data.payload.proposalId": 1, "data.payload.stage": "confirm", "data.payload.bothLocked": true, "data.payload.mine.locked": true, "data.payload.theirs.locked": true }, "timeoutMs": 12000, "as": "doubleLockedTrade" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-alpha:field-pack", "itemId": 1001, "variantId": 0, "match": { "reserved": { "op": "eq", "value": 0 }, "available": { "op": "eq", "value": 4 } } }, "timeoutMs": 12000, "as": "alphaLockedOfferInventory" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-beta:field-pack", "itemId": 2001, "variantId": 0, "match": { "reserved": { "op": "eq", "value": 0 }, "available": { "op": "eq", "value": 5 } } }, "timeoutMs": 12000, "as": "betaLockedOfferInventory" } },
    { "command": { "actor": "alpha", "body": { "ConfirmTrade": { "proposal_id": 1 } }, "as": "alphaConfirmsTrade" } },
    { "expect": { "kind": "captureCompare", "capture": "alphaConfirmsTrade", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-beta:field-pack", "itemId": 2001, "variantId": 0, "match": { "reserved": { "op": "eq", "value": 0 }, "available": { "op": "eq", "value": 5 } } }, "timeoutMs": 12000, "as": "firstConfirmLeavesTradeOffer" } },
    { "command": { "actor": "beta", "body": { "ConfirmTrade": { "proposal_id": 1 } }, "as": "betaConfirmsTrade" } },
    { "expect": { "kind": "captureCompare", "capture": "betaConfirmsTrade", "path": "receipt.accepted", "op": "eq", "value": true } },
    { "await": { "kind": "event", "actor": "alpha", "event": "trade_session", "match": { "data.payload.proposalId": 1, "data.payload.stage": "executed", "data.payload.bothLocked": true, "data.payload.mine.confirmed": true, "data.payload.theirs.confirmed": true }, "timeoutMs": 12000, "as": "tradeExecutedOnce" } },
    { "command": { "actor": "alpha", "body": { "ConfirmTrade": { "proposal_id": 1 } }, "as": "duplicateTradeConfirm" } },
    { "expect": { "kind": "captureCompare", "capture": "duplicateTradeConfirm", "path": "receipt.accepted", "op": "eq", "value": false } },
    { "expect": { "kind": "captureCompare", "capture": "duplicateTradeConfirm", "path": "receipt.reasonCode", "op": "eq", "value": "no_trade_session" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-alpha:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 6 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "alphaExactVariantFinal" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "mp-trade-beta:field-pack", "itemId": 2001, "variantId": 211337, "match": { "available": { "op": "eq", "value": 4 }, "reserved": { "op": "eq", "value": 0 } } }, "timeoutMs": 12000, "as": "betaExactVariantFinal" } }
  ],
  "notes": "Checkpoint captures two real pending invitations (alpha→beta and alpha→gamma) plus a shared exact-variant Iron row after alpha and beta each store 3 of their 5 units. Restart evidence proves a distinct process and persisted nonzero checkpoint; post-restart /group queries prove inviter/invitee identities before beta accepts once and gamma declines once, with duplicate terminal answers rejected and alpha-led membership visible from both group members. The restored exchange row totals 6 with zero reservation. Alpha's first quantity-4 retrieve wins deterministically; beta's competing quantity-4 retrieve rejects item_unavailable, then beta retrieves the exact remaining 2. Final exact rows are alpha 6, beta 4, exchange 0, all reserved 0: conserved total 10 with no duplication/loss/reservation leak. The existing funded two-sided trade remains intact and executes exactly once, with duplicate confirmation rejected."
}
