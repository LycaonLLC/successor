{
  "schema": "successor.scenario.v1",
  "name": "loot-restart-persistence",
  "fixture": "open-desert-multiplayer-loot-restart-cache",
  "persistence": true,
  "lanes": ["accel"],
  "tags": ["restart", "loot", "multiplayer"],
  "actors": {
    "alpha": { "character": "fixture:alpha" },
    "beta": { "character": "fixture:beta" }
  },
  "steps": [
    { "command": { "actor": "alpha", "body": { "DebugGrantSkillBoxes": { "skill_box_ids": ["marksman-novice"] } }, "as": "alphaGrantMarksman" } },
    { "command": { "actor": "alpha", "body": { "DebugGiveItem": { "item_id": 3101, "variant_id": 0, "quantity": 1, "equip": true } }, "as": "alphaGiveSlugthrower" } },
    { "command": { "actor": "alpha", "body": { "DebugGiveItem": { "item_id": 1101, "variant_id": 0, "quantity": 240, "equip": false } }, "as": "alphaGiveAmmo" } },
    { "command": { "actor": "beta", "body": { "DebugGrantSkillBoxes": { "skill_box_ids": ["marksman-novice"] } }, "as": "betaGrantMarksman" } },
    { "command": { "actor": "beta", "body": { "DebugGiveItem": { "item_id": 3101, "variant_id": 0, "quantity": 1, "equip": true } }, "as": "betaGiveSlugthrower" } },
    { "command": { "actor": "beta", "body": { "DebugGiveItem": { "item_id": 1101, "variant_id": 0, "quantity": 240, "equip": false } }, "as": "betaGiveAmmo" } },
    { "await": { "kind": "query", "actor": "alpha", "query": "/nearby all", "match": { "data.actors": { "includesObject": { "id": "mp-loot-rogue", "lifeState": "alive" } } }, "timeoutMs": 12000, "intervalMs": 250, "as": "alphaSeesRogue" } },
    { "send": { "actor": "alpha", "line": "/target mp-loot-rogue", "as": "alphaTarget" } },
    { "send": { "actor": "alpha", "line": "/attack", "as": "alphaAttack" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaAttack.data.commandId", "commandKind": "QueueCombatAction", "accepted": true }, "timeoutMs": 12000, "as": "alphaAttackReceipt" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-loot-rogue", "match": { "vitals.health": { "op": "lt", "value": 70 } } }, "timeoutMs": 60000, "as": "alphaHasDeterministicLootLead" } },
    { "send": { "actor": "beta", "line": "/target mp-loot-rogue", "as": "betaTarget" } },
    { "send": { "actor": "beta", "line": "/attack", "as": "betaAttack" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.betaAttack.data.commandId", "commandKind": "QueueCombatAction", "accepted": true }, "timeoutMs": 12000, "as": "betaAttackReceipt" } },
    { "await": { "kind": "event", "actor": "beta", "event": "combat", "match": { "data.event.shooterActorId": "mp-loot-beta", "data.event.targetActorId": "mp-loot-rogue" }, "timeoutMs": 40000, "as": "betaAssistHit" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-loot-rogue", "setLastKill": true, "match": { "lifeState": "downed", "lootable": true, "hasLoot": true, "lootRightsActorId": "mp-loot-alpha" } }, "timeoutMs": 90000, "as": "corpseWithOwnerRight" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "corpse:$last_kill", "itemId": 1001, "variantId": 0, "match": { "available": { "op": "eq", "value": 2 } } }, "timeoutMs": 12000, "as": "corpseStackBeforeRestart" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "cache:mp-loot-restart-cache", "itemId": 2001, "variantId": 0, "match": { "available": { "op": "eq", "value": 3 } } }, "timeoutMs": 12000, "as": "cacheStackBeforeRestart" } },
    { "restart": { "as": "restartEvidence", "timeoutMs": 30000 } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-loot-rogue", "match": { "lifeState": "downed", "lootable": true, "hasLoot": true, "lootRightsActorId": "mp-loot-alpha" } }, "timeoutMs": 12000, "as": "restoredCorpseRight" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "corpse:mp-loot-rogue", "itemId": "$captures.corpseStackBeforeRestart.itemId", "variantId": "$captures.corpseStackBeforeRestart.variantId", "match": { "available": { "op": "eq", "value": "$captures.corpseStackBeforeRestart.available" } } }, "timeoutMs": 12000, "as": "restoredCorpseStack" } },
    { "await": { "kind": "oracle", "condition": { "type": "inventoryRow", "container": "cache:mp-loot-restart-cache", "itemId": "$captures.cacheStackBeforeRestart.itemId", "variantId": "$captures.cacheStackBeforeRestart.variantId", "match": { "available": { "op": "eq", "value": "$captures.cacheStackBeforeRestart.available" } } }, "timeoutMs": 12000, "as": "restoredCacheStack" } },
    { "send": { "actor": "beta", "line": "/kneel", "as": "betaPostRestartKneel" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.betaPostRestartKneel.data.commandId", "commandKind": "SetPosture", "accepted": true }, "timeoutMs": 12000, "as": "betaPostRestartKneelReceipt" } },
    { "send": { "actor": "alpha", "line": "/loot cache:mp-loot-restart-cache $captures.restoredCacheStack.itemId $captures.restoredCacheStack.variantId $captures.restoredCacheStack.available", "as": "alphaTakeRestoredCache" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaTakeRestoredCache.data.commandId", "commandKind": "TakeLootItem", "accepted": true }, "timeoutMs": 12000, "as": "restoredCacheTerminal" } },
    { "send": { "actor": "beta", "line": "/loot corpse:mp-loot-rogue $captures.restoredCorpseStack.itemId $captures.restoredCorpseStack.variantId 1", "as": "betaRestoredLootAttempt" } },
    { "await": { "kind": "receipt", "actor": "beta", "match": { "commandId": "$captures.betaRestoredLootAttempt.data.commandId", "commandKind": "TakeLootItem", "accepted": false, "reasonCode": "loot_no_rights" }, "timeoutMs": 12000, "as": "restoredRightReject" } },
    { "send": { "actor": "alpha", "line": "/loot corpse:mp-loot-rogue $captures.restoredCorpseStack.itemId $captures.restoredCorpseStack.variantId $captures.restoredCorpseStack.available", "as": "alphaTakeRestoredCorpse" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaTakeRestoredCorpse.data.commandId", "commandKind": "TakeLootItem", "accepted": true }, "timeoutMs": 12000, "as": "restoredCorpseTerminal" } },
    { "await": { "kind": "oracle", "condition": { "type": "actor", "actor": "mp-loot-rogue", "match": { "lifeState": "downed", "lootable": false, "hasLoot": false, "lootRightsActorId": "mp-loot-alpha" } }, "timeoutMs": 12000, "as": "corpseExhaustedAfterSingleTake" } },
    { "send": { "actor": "alpha", "line": "/loot cache:mp-loot-restart-cache $captures.restoredCacheStack.itemId $captures.restoredCacheStack.variantId 1", "as": "alphaDuplicateCacheTake" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaDuplicateCacheTake.data.commandId", "commandKind": "TakeLootItem", "accepted": false, "reasonCode": "loot_not_lootable" }, "timeoutMs": 12000, "as": "duplicateCacheTerminalReject" } },
    { "send": { "actor": "alpha", "line": "/loot corpse:mp-loot-rogue $captures.restoredCorpseStack.itemId $captures.restoredCorpseStack.variantId 1", "as": "alphaDuplicateCorpseTake" } },
    { "await": { "kind": "receipt", "actor": "alpha", "match": { "commandId": "$captures.alphaDuplicateCorpseTake.data.commandId", "commandKind": "TakeLootItem", "accepted": false, "reasonCode": "loot_not_lootable" }, "timeoutMs": 12000, "as": "duplicateCorpseTerminalReject" } },
    { "expect": { "kind": "envelopeCount", "actor": "alpha", "envelopeType": "receipt", "match": { "commandKind": "TakeLootItem", "accepted": true }, "op": "eq", "value": 2 } },
    { "expect": { "kind": "envelopeCount", "actor": "alpha", "envelopeType": "receipt", "match": { "commandKind": "TakeLootItem", "accepted": false, "reasonCode": "loot_not_lootable" }, "op": "eq", "value": 2 } },
    { "expect": { "kind": "envelopeCount", "actor": "beta", "envelopeType": "receipt", "match": { "commandKind": "TakeLootItem", "accepted": true }, "op": "eq", "value": 0 } },
    { "expect": { "kind": "envelopeCount", "actor": "beta", "envelopeType": "receipt", "match": { "commandKind": "TakeLootItem", "accepted": false, "reasonCode": "loot_no_rights" }, "op": "eq", "value": 1 } }
  ],
  "notes": "A narrow dedicated fixture supplies a nearby cache without changing the shared corpse-contention fixture. Alpha earns the deterministic corpse right and beta lands one real assist; the checkpoint records the downed lootable corpse, exact corpse stack, and exact cache stack. After the isolated process restart, both source rows and alpha-only corpse right must return unchanged. Beta first submits an accepted posture command to prove its reconnected command-ID continuity before its honest rights rejection. Alpha then drains each restored source once; the exhausted corpse loses its lootable state, both duplicate takes reject loot_not_lootable, and receipt counts prove exactly one accepted terminal take per source. The restart runner validates fixture source hash and persistence paths before reconnecting."
}
