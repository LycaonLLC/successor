#!/usr/bin/env bash
set -Eeuo pipefail
exec >/var/log/successor-user-data.log 2>&1

STATE_DEVICE='${state_device}'
EXPECTED_STATE_TAG='${expected_state_tag}'
BACKUP_INTERVAL_MINUTES='${backup_interval_minutes}'
STATE_DIR='/var/lib/successor'
STATE_ROOT="$STATE_DIR/live"
RUN_DIR='/run/successor'
INITIALIZE_APPROVAL='${initialize_empty_volume}'
[[ "$INITIALIZE_APPROVAL" == "true" ]] && export SUCCESSOR_INITIALIZE_EMPTY_VOLUME=I_UNDERSTAND_INITIALIZE_EMPTY_VOLUME

if command -v dnf >/dev/null; then
  dnf install -y docker amazon-ssm-agent awscli-2 util-linux tar gzip
else
  echo 'Successor staging requires Amazon Linux 2023 (dnf)' >&2
  exit 1
fi
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent
install -d -m 0750 -o root -g root "$STATE_DIR" "$RUN_DIR" /etc/successor /usr/local/libexec

for attempt in $(seq 1 60); do
  udevadm settle --timeout=5 || true
  [[ -b "$STATE_DEVICE" ]] && break
  sleep 2
done
[[ -b "$STATE_DEVICE" ]] || { echo "missing EBS state device after bounded wait: $STATE_DEVICE" >&2; exit 1; }
DEVICE_REAL=$(readlink -f "$STATE_DEVICE")
IMDS_TOKEN=$(curl -fsS -X PUT --max-time 3 -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)
INSTANCE_ID=$(curl -fsS --max-time 3 -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
EXPECTED_VOLUME_ID=$(aws ec2 describe-volumes --region '${aws_region}' --filters Name=attachment.instance-id,Values="$INSTANCE_ID" Name=attachment.device,Values=/dev/xvdf --query 'Volumes[0].VolumeId' --output text)
EXPECTED_VOLUME_NAME=$(aws ec2 describe-volumes --region '${aws_region}' --volume-ids "$EXPECTED_VOLUME_ID" --query "Volumes[0].Tags[?Key=='Name'].Value | [0]" --output text)
INITIALIZED_TAG=$(aws ec2 describe-volumes --region '${aws_region}' --volume-ids "$EXPECTED_VOLUME_ID" --query "Volumes[0].Tags[?Key=='StateInitialized'].Value | [0]" --output text)
[[ "$EXPECTED_VOLUME_NAME" == "$EXPECTED_STATE_TAG" ]] || { echo "attached EBS tag mismatch: $EXPECTED_VOLUME_NAME" >&2; exit 1; }
SERIAL=$(lsblk -ndo SERIAL "$DEVICE_REAL" || true)
[[ -n "$SERIAL" ]] || { echo "EBS device has no stable serial: $DEVICE_REAL" >&2; exit 1; }
for stable in /dev/disk/by-id/*"$SERIAL"; do
  if [[ -e "$stable" ]]; then STATE_DEVICE=$(readlink -f "$stable"); break; fi
done
[[ -b "$STATE_DEVICE" ]] || { echo "stable EBS by-id link missing for serial $SERIAL" >&2; exit 1; }
if ! blkid "$STATE_DEVICE" >/dev/null 2>&1; then
  [[ "$INITIALIZED_TAG" != "true" ]] || { echo "state volume was previously initialized; refusing reformat" >&2; exit 1; }
  [[ "$${SUCCESSOR_INITIALIZE_EMPTY_VOLUME:-}" == "I_UNDERSTAND_INITIALIZE_EMPTY_VOLUME" ]] || { echo 'refusing to format an unrecognized EBS volume without explicit initialization approval' >&2; exit 1; }
  mkfs.ext4 -F "$STATE_DEVICE"
  aws ec2 create-tags --region '${aws_region}' --resources "$EXPECTED_VOLUME_ID" --tags Key=StateInitialized,Value=true
fi
if ! mountpoint -q "$STATE_DIR"; then
  mount -o noatime,nodiratime "$STATE_DEVICE" "$STATE_DIR"
fi
findmnt -rn -S "$STATE_DEVICE" -T "$STATE_DIR" >/dev/null
if ! grep -Fq "$STATE_DEVICE $STATE_DIR ext4" /etc/fstab; then
  printf '%s %s ext4 noatime,nodiratime,nofail,x-systemd.device-timeout=60s 0 2\n' "$STATE_DEVICE" "$STATE_DIR" >>/etc/fstab
fi
chown -R 10001:10001 "$STATE_DIR"
install -d -m 0700 -o 10001 -g 10001 "$STATE_ROOT/state"
printf 'SUCCESSOR_RETENTION_ENABLED=1\nSUCCESSOR_RETENTION_KEEP_RECENT=3\nSUCCESSOR_RETENTION_KEEP_FAILED=3\nSUCCESSOR_RETENTION_MAX_AGE_DAYS=30\nSUCCESSOR_BACKUP_INTERVAL_MINUTES=%s\nSUCCESSOR_RETENTION_ARCHIVE_PREFIX=state\n' "$BACKUP_INTERVAL_MINUTES" >/etc/successor/backup-retention.env
chmod 0600 /etc/successor/backup-retention.env
runtime_secret="$(aws ssm get-parameter --name '${runtime_secret_parameter_name}' --with-decryption --query Parameter.Value --output text)"
runtime_bearer="$(aws ssm get-parameter --name '${runtime_bearer_parameter_name}' --with-decryption --query Parameter.Value --output text)"
control_secret="$(aws ssm get-parameter --name '${control_secret_parameter_name}' --with-decryption --query Parameter.Value --output text)"
[[ -n "$runtime_secret" && "$runtime_secret" != "None" ]] || { echo 'runtime secret parameter is empty' >&2; exit 1; }
[[ -n "$runtime_bearer" && "$runtime_bearer" != "None" ]] || { echo 'runtime bearer parameter is empty' >&2; exit 1; }
[[ -n "$control_secret" && "$control_secret" != "None" ]] || { echo 'alpha control secret parameter is empty' >&2; exit 1; }
[[ "$runtime_secret" != *$'\n'* && "$runtime_secret" != *$'\r'* && "$runtime_bearer" != *$'\n'* && "$runtime_bearer" != *$'\r'* && "$control_secret" != *$'\n'* && "$control_secret" != *$'\r'* ]] || { echo 'runtime parameters contain unsupported newlines' >&2; exit 1; }
printf 'SUCCESSOR_IMAGE_REF=%s\nSUCCESSOR_RUNTIME_SECRET=%s\nSUCCESSOR_RUNTIME_BEARER_TOKEN=%s\nALPHA_CONTROL_CLAIM_SECRET=%s\nSUCCESSOR_CONTROL_PLANE_MODE=standalone\nSUCCESSOR_ALPHA_ORIGIN=https://www.successorgame.com\nSUCCESSOR_ALPHA_CLIENT_ORIGIN=%s\nSUCCESSOR_ALPHA_GAME_ENDPOINT=wss://world.successorgame.com\nSUCCESSOR_ALPHA_CHAT_ENDPOINT=wss://world.successorgame.com/chat/ws\nSUCCESSOR_ALPHA_LEGAL_VERSIONS={"terms":"2026-07-24","privacy":"2026-07-24"}\nSUCCESSOR_ALPHA_REGISTRATION_OPEN=true\nSUCCESSOR_ALPHA_REGISTRATION_CAP=64\nSUCCESSOR_ALPHA_TRUSTED_PROXY_HOPS=2\nSUCCESSOR_SITE_URL=%s\nSUCCESSOR_STATE_ROOT=/var/lib/successor/live\nSUCCESSOR_BACKUP_S3_URI=s3://${backup_bucket_name}/state\nSUCCESSOR_CHECKPOINT_PATH=/var/lib/successor/live/state/%s.checkpoint.json\nSUCCESSOR_SHARD_NAME=successor-staging-1\nSUCCESSOR_SHARD_ID=%s\nSUCCESSOR_CLIENT_RELEASE_ID=%s\nSUCCESSOR_ALPHA_CLIENT_RELEASE_ALLOWLIST=%s\nSUCCESSOR_SERVER_RELEASE_ID=%s\nSUCCESSOR_RELEASE_ID=%s\nSUCCESSOR_LAUNCH_ISSUER=successor-staging-1\nGAME_SHARD_ID=%s\nGAME_SHARD_PERSISTENCE=1\nGAME_CHARACTER_STORE_PATH=/var/lib/successor/live/characters.json\nGAME_SHARD_STATE_DIR=/var/lib/successor/live\nGAME_SHARD_CHECKPOINT_PATH=/var/lib/successor/live/state/%s.checkpoint.json\nGAME_SHARD_JOURNAL_PATH=/var/lib/successor/live/state/%s.journal.jsonl\nGAME_SHARD_MANIFEST_PATH=/var/lib/successor/live/state/state-generation.manifest.json\nALPHA_CONTROL_DB_PATH=/var/lib/successor/live/control.sqlite\nSUCCESSOR_LOG_GROUP=/successor/successor-staging-1\nAWS_REGION=%s\n' '${container_image}' "$runtime_secret" "$runtime_bearer" "$control_secret" '${client_cdn_origin}' '${site_url}' '${shard_id}' '${shard_id}' '${client_release_id}' '${client_release_allowlist}' '${server_release_id}' '${release_id}' '${shard_id}' '${shard_id}' '${shard_id}' '${aws_region}' >/etc/successor/runtime.env
chmod 0600 /etc/successor/runtime.env

BOOTSTRAP_ROOT='/run/successor-bootstrap'
install -d -m 0700 "$BOOTSTRAP_ROOT"
aws s3 cp 's3://${backup_bucket_name}/bootstrap/${bootstrap_revision}/' "$BOOTSTRAP_ROOT/" --recursive --only-show-errors
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor.service" /etc/systemd/system/successor.service
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-backup.service" /etc/systemd/system/successor-backup.service
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-backup.timer" /etc/systemd/system/successor-backup.timer
sed -i "s/BACKUP_INTERVAL_MINUTES/${backup_interval_minutes}/" /etc/systemd/system/successor-backup.timer
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-metrics.service" /etc/systemd/system/successor-metrics.service
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-metrics.timer" /etc/systemd/system/successor-metrics.timer
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-cleanup.service" /etc/systemd/system/successor-cleanup.service
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-cleanup.timer" /etc/systemd/system/successor-cleanup.timer
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-restore-rehearsal.service" /etc/systemd/system/successor-restore-rehearsal.service
install -m 0644 "$BOOTSTRAP_ROOT/systemd/successor-restore-rehearsal.timer" /etc/systemd/system/successor-restore-rehearsal.timer
install -m 0750 "$BOOTSTRAP_ROOT/scripts/preflight.sh" /usr/local/libexec/successor-preflight.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/run-authority.sh" /usr/local/libexec/successor-run.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/backup.sh" /usr/local/libexec/successor-backup.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/restore.sh" /usr/local/libexec/successor-restore.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/deploy.sh" /usr/local/libexec/successor-deploy.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/maintenance-deploy.sh" /usr/local/libexec/successor-maintenance-deploy.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/rollback.sh" /usr/local/libexec/successor-rollback.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/post-session-review.sh" /usr/local/libexec/successor-post-session-review.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/metrics.sh" /usr/local/libexec/successor-metrics.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/cleanup-generations.sh" /usr/local/libexec/successor-cleanup-generations.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/validate-retention.sh" /usr/local/libexec/successor-validate-retention.sh
install -m 0750 "$BOOTSTRAP_ROOT/scripts/restore-rehearsal.sh" /usr/local/libexec/successor-restore-rehearsal.sh
rm -rf "$BOOTSTRAP_ROOT"
chmod 0750 /usr/local/libexec/successor-*.sh
systemctl daemon-reload
systemctl enable successor.service successor-backup.timer successor-metrics.timer successor-cleanup.timer successor-restore-rehearsal.timer
systemctl start successor.service
